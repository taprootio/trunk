# Required: PostgreSQL URL. In App Platform this is injected from the named
# `reference-db` component as DATABASE_URL.
DATABASE_URL=postgres://reference:replace-me@127.0.0.1:5432/reference
# Managed PostgreSQL deployments provide the private CA certificate chain as a
# secret. Leave it unset for an intentionally plain local TCP connection.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----

# The public HTTPS origin registered as the integration's webhook and settings URL.
PUBLIC_ORIGIN=https://reference.example.com
# Set true only for initial operator registration. The process serves only the
# public manifest and reports /readyz as unavailable. After registration has
# supplied the integration id, publisher credential, and signing key, unset it
# and restart with every remaining required value below.
REFERENCE_BOOTSTRAP_MANIFEST_ONLY=false
# The public Taproot API origin. It must be HTTPS.
TAPROOT_API_URL=https://app.taproot.io/api
INTEGRATION_ID=00000000-0000-4000-8000-000000000000

# Publisher authority is used only to claim installation.created and to upload
# a bundle. It is never used for installation content or settings confirmation.
PUBLISHER_CREDENTIAL=replace-with-publisher-credential

# JSON mapping signing-key id to the base64 signing secret. Keep both active
# values during a platform key rotation, then remove the retired key.
TAPROOT_WEBHOOK_SIGNING_KEYS={"00000000-0000-4000-8000-000000000000":"base64-secret"}

# Exactly 32 bytes encoded in base64. Rotating this key needs a planned
# re-encryption migration; changing it without that migration loses access to
# credential and receipt ciphertexts.
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Taproot's issuer and JWKS document for signed settings handoffs.
TAPROOT_HANDOFF_ISSUER=https://app.taproot.io
TAPROOT_HANDOFF_JWKS_URL=https://app.taproot.io/api/.well-known/taproot-integrations-jwks.json

# Optional local settings. App Platform supplies PORT and production defaults.
PORT=8080
# Bind loopback for local development. App Platform sets 0.0.0.0.
HOST=127.0.0.1
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_LEASE_SECONDS=60
WEBHOOK_POLL_MILLISECONDS=1000
# Durable admission includes every completed tombstone and every accepted
# received/retry/processing/terminal receipt; at the cap new deliveries get a
# retriable 503 while matching delivery ids still get their duplicate 2xx.
WEBHOOK_MAX_RETAINED_RECEIPTS=50000
# Outstanding means received, retry, processing, or terminal for one
# installation. Terminal rows retain encrypted body/journal evidence for manual
# reconciliation without blocking another installation's deliveries.
WEBHOOK_MAX_OUTSTANDING_RECEIPTS=512
# Bounds raw signed body bytes before encryption. The encrypted envelope has a
# fixed AES-GCM overhead. Completed tombstones clear it; terminal evidence stays.
WEBHOOK_MAX_RECEIPT_BYTES=262144
# A receipt may retain only these encrypted journal bounds until completion.
# The placement-list response may reserve the full response value; fragments
# reserve 4 KiB and other operations reserve 16 KiB. Terminal receipts retain
# their bounded journal for reconciliation.
WEBHOOK_MAX_OPERATIONS_PER_RECEIPT=512
WEBHOOK_MAX_OPERATION_BYTES_PER_RECEIPT=2097152
WEBHOOK_MAX_OPERATION_RESPONSE_BYTES=524288
# Normal deployments use full. Select an explicit variant only for a controlled
# acceptance run; restart with full immediately afterwards.
REFERENCE_SYNC_MODE=full
