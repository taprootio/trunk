{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.taproot.io/integrations/manifest.v1.schema.json",
  "title": "Taproot integration manifest v1",
  "description": "The public declarative integration registry contract. validateManifest applies additional bounded semantic checks; Taproot remains authoritative for DNS and registration policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug", "displayName", "webhookEndpointUrl", "settingsUrl", "requestedCapabilities",
    "offeredComponents", "externalScriptOrigins", "defaultPublishPolicy",
    "recommendedUninstallDisposition", "contractVersion", "pricingOptions"
  ],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "minLength": 1, "maxLength": 64 },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "webhookEndpointUrl": { "$ref": "#/$defs/endpoint" },
    "settingsUrl": { "$ref": "#/$defs/endpoint" },
    "requestedCapabilities": {
      "type": "array", "uniqueItems": true, "maxItems": 32,
      "items": { "enum": ["pages.manage_own", "data.manage_own", "media.manage_own", "publish", "site.pages.read", "fragments.manage_own"] }
    },
    "offeredComponents": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/component" } },
    "externalScriptOrigins": { "$ref": "#/$defs/origins" },
    "externalConnectOrigins": { "$ref": "#/$defs/origins" },
    "externalScriptOriginReasons": { "$ref": "#/$defs/originReasons" },
    "externalConnectOriginReasons": { "$ref": "#/$defs/originReasons" },
    "defaultPublishPolicy": { "enum": ["auto", "stage"] },
    "recommendedUninstallDisposition": { "enum": ["freeze", "remove"] },
    "contractVersion": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$", "minLength": 1, "maxLength": 64 },
    "pricingOptions": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/pricingOption" } }
  },
  "$defs": {
    "endpoint": {
      "type": "string", "format": "uri", "maxLength": 2048,
      "pattern": "^https://"
    },
    "origins": {
      "type": "array", "uniqueItems": true, "maxItems": 16,
      "items": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 }
    },
    "originReasons": {
      "type": "object", "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "component": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "configSchema"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier64" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "configSchema": { "$ref": "#/$defs/configSchema" }
      }
    },
    "identifier64": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "minLength": 1, "maxLength": 64 },
    "pricingOption": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "quantityMin", "quantityMax", "cadence", "catalogueItemKey"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier64" },
        "version": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$", "minLength": 1, "maxLength": 64 },
        "quantityMin": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "quantityMax": { "type": ["integer", "null"], "minimum": 1, "maximum": 100000 },
        "cadence": { "enum": ["free", "monthly", "annual"] },
        "catalogueItemKey": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "configSchema": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "enum": ["object", "array", "string", "number", "integer", "boolean"] },
        "properties": { "type": "object", "maxProperties": 32, "additionalProperties": { "$ref": "#/$defs/configSchema" } },
        "required": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "items": { "$ref": "#/$defs/configSchema" },
        "enum": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": ["string", "number", "boolean"] } },
        "additionalProperties": { "const": false },
        "minLength": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "maxLength": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" }
      }
    }
  }
}
