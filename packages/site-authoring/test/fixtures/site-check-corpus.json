{
  "version": 1,
  "about": "Cases both the C# evaluator (Taproot.Domain/SiteChecks) and the TypeScript evaluator (shared/site-checks.ts) must pass. 'links' pin the internal link extractor, 'redirectSources' pin source normalization and the redirect source rules, 'pageLinks' pin the link.page_missing findings for one page.",
  "links": [
    {
      "name": "html anchors and an entity-encoded componentData are read",
      "currentPath": "guides/start",
      "templateData": {
        "html": "<a href='/missing/raw'>Raw</a>",
        "componentData": "{&quot;items&quot;:[{&quot;url&quot;:&quot;/missing/card&quot;}]}"
      },
      "expected": [
        "/missing/card",
        "/missing/raw"
      ]
    },
    {
      "name": "an encoded query delimiter is cut after decoding",
      "currentPath": "home",
      "templateData": {
        "href": "/guides/start%3Fpreview=true"
      },
      "expected": [
        "/guides/start"
      ]
    },
    {
      "name": "an encoded fragment delimiter is cut after decoding",
      "currentPath": "home",
      "templateData": {
        "href": "/guides/start%23details"
      },
      "expected": [
        "/guides/start"
      ]
    },
    {
      "name": "rich-text link marks resolve relative to the page's folder",
      "currentPath": "guides/start",
      "templateData": {
        "body": {
          "type": "doc",
          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "link",
                  "attrs": {
                    "href": "/about"
                  }
                }
              ]
            },
            {
              "type": "text",
              "marks": [
                {
                  "type": "link",
                  "attrs": {
                    "href": "next"
                  }
                }
              ]
            },
            {
              "type": "text",
              "marks": [
                {
                  "type": "link",
                  "attrs": {
                    "href": "../up/"
                  }
                }
              ]
            },
            {
              "type": "text",
              "marks": [
                {
                  "type": "link",
                  "attrs": {
                    "href": "./same"
                  }
                }
              ]
            }
          ]
        }
      },
      "expected": [
        "/about",
        "/guides/next",
        "/guides/same",
        "/up"
      ]
    },
    {
      "name": "external, fragment, query, protocol-relative, mail and asset targets are not pages",
      "currentPath": "home",
      "templateData": {
        "items": [
          {
            "href": "https://example.com/page"
          },
          {
            "href": "mailto:a@example.com"
          },
          {
            "href": "tel:+15555550100"
          },
          {
            "href": "#part"
          },
          {
            "href": "?q=1"
          },
          {
            "href": "//cdn.example.com/x"
          },
          {
            "href": "/images/photo.webp"
          },
          {
            "href": "/files/report.PDF"
          },
          {
            "href": "/back\\slash"
          },
          {
            "href": ""
          }
        ]
      },
      "expected": []
    },
    {
      "name": "the site root, a trailing slash and a query are normalized",
      "currentPath": "home",
      "templateData": {
        "a": {
          "href": "/"
        },
        "b": {
          "href": "/about/"
        },
        "c": {
          "href": "/pricing?plan=pro#top"
        }
      },
      "expected": [
        "/",
        "/about",
        "/pricing"
      ]
    },
    {
      "name": "targets differing by case are one link, and the first spelling is kept",
      "currentPath": "home",
      "templateData": {
        "a": {
          "href": "/About"
        },
        "b": {
          "href": "/about"
        }
      },
      "expected": [
        "/About"
      ]
    },
    {
      "name": "property names match without regard to case",
      "currentPath": "home",
      "templateData": {
        "a": {
          "HREF": "/one"
        },
        "b": {
          "Url": "/two"
        },
        "c": {
          "LINK": "/three"
        },
        "d": {
          "pagePath": "/four"
        }
      },
      "expected": [
        "/four",
        "/one",
        "/three",
        "/two"
      ]
    },
    {
      "name": "a componentData string that is not JSON is read as HTML",
      "currentPath": "home",
      "templateData": {
        "componentData": "<a href=\"/from-html\">x</a>"
      },
      "expected": [
        "/from-html"
      ]
    },
    {
      "name": "bare strings in an array are not examined",
      "currentPath": "home",
      "templateData": {
        "items": [
          "/not-a-link"
        ]
      },
      "expected": []
    },
    {
      "name": "a relative link that climbs above the root is dropped",
      "currentPath": "start",
      "templateData": {
        "href": "../../x"
      },
      "expected": []
    },
    {
      "name": "named and numeric character references in an address are decoded",
      "currentPath": "home",
      "templateData": {
        "a": {
          "href": "/caf&eacute;"
        },
        "b": {
          "href": "/na&#239;ve"
        },
        "c": {
          "href": "/a&amp;b"
        },
        "d": {
          "href": "/&alpha;&beta;"
        },
        "e": {
          "href": "/x&hellip;"
        }
      },
      "expected": [
        "/a&b",
        "/café",
        "/naïve",
        "/x…",
        "/αβ"
      ]
    }
  ],
