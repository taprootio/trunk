{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.taproot.test/integrations/webhooks/v1/ping.schema.json",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "type": { "const": "ping" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["purpose"],
          "properties": { "purpose": { "type": "string", "minLength": 1 } }
        }
      }
    }
  ]
}
