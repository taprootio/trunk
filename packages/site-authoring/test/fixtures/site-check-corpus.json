  "pageLinks": [
    {
      "name": "a link to a page the site has is not reported, case and slashes aside",
      "currentPath": "guides/start",
      "templateData": {
        "a": {
          "href": "/About/"
        },
        "b": {
          "href": "next"
        }
      },
      "sitePagePaths": [
        "about",
        "guides/next",
        "other"
      ],
      "expected": []
    },
    {
      "name": "links to pages the site lacks are reported in order",
      "currentPath": "guides/start",
      "templateData": {
        "a": {
          "href": "/team"
        },
        "b": {
          "href": "/about"
        },
        "c": {
          "href": "gone"
        }
      },
      "sitePagePaths": [
        "about",
        "/guides/start"
      ],
      "expected": [
        "/guides/gone",
        "/team"
      ]
    },
    {
      "name": "a named character reference matches the page it spells",
      "currentPath": "home",
      "templateData": {
