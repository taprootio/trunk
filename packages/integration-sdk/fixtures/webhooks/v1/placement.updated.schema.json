{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.taproot.test/integrations/webhooks/v1/placement.updated.schema.json",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "type": { "const": "placement.updated" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["placementId", "componentId", "placementRevision", "config"],
          "properties": {
            "placementId": { "type": "string", "format": "uuid" },
            "componentId": { "type": "string", "minLength": 1 },
            "placementRevision": { "type": "integer", "minimum": 0 },
            "config": true
          }
        }
      }
    }
  ]
}
